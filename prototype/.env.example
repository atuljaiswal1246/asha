# Jarvis — environment template. Copy to prototype/.env and fill in.
# NEVER commit real keys; prototype/.env is gitignored.

# --- Models (OpenCode: free zen + paid go) ---
OPENCODE_API_KEY=
# Paid go tier (optional; used for the supervisor/go models)
SUPERVISOR_API_KEY=

# --- Image generation (BYOK — each user brings their own key) ---
# Leonardo.Ai — https://app.leonardo.ai (API Access → Create New Key)
# IMAGE_PROVIDER=leonardo            # leonardo (default) | pollinations (free, no key)
LEONARDO_API_KEY=
# LEONARDO_MODEL_ID=b24e16ff-06e3-43eb-8d33-4416c2d75876
# LEONARDO_ALCHEMY=1

# --- Web search ---
# Exa (recommended; LLM-optimized search) — https://exa.ai
EXA_API_KEY=
# Tavily (fallback) — https://tavily.com
TAVILY_API_KEY=

# --- Optional local/other providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# --- Voice / models (defaults are fine) ---
# TTS_VOICE=af_heart
# STT_MODEL=
# INTERRUPT_ENABLED=true

# --- Agent loop tunables (all optional; defaults shown) ---
# AGENT_CTX_MAX_CHARS=180000         # hard context window (chars)
# AGENT_COMPACT_TRIGGER=0.75         # summarize the middle when this full
# AGENT_PROTECT_FIRST=3              # keep the first N turns when compressing
# AGENT_PROTECT_LAST=12              # keep the last N turns when compressing
# AGENT_SUMMARY_MAX_CHARS=6000       # cap on a model-written summary
# AGENT_MAX_DEPTH=1                  # delegation nesting (1 = flat, Hermes-like)
# AGENT_SUBAGENT_SUMMARY_CHARS=6000  # cap on a sub-agent's returned summary
# AGENT_ALLOW_DANGEROUS=0            # 1 disables the hardline command guard
# AGENT_SKILLS_DIR=                  # override the agent skill store path
# CRON_ENABLED=0                     # 1 enables the scheduler
# LLM_FALLBACK=0                     # 1 enables opt-in free-model fallback
