# ─────────────────────────────────────────────────────────────────────────────
# Asha — SHIPPED CONFIG TEMPLATE (keyless build)
#
# This file is copied into the app bundle as `app/.env`, so treat it as public:
# it must contain NO credentials. Provider API keys live only on the Asha
# proxy (Cloudflare); they are never shipped to a user's machine.
#
# The per-user plan token is not here either: it is issued to the user at
# sign-in and stored outside the bundle, under the app data dir.
#
# Values allowed here are non-secret: model names, base URLs, feature flags,
# limits and voice settings.
# ─────────────────────────────────────────────────────────────────────────────

# The one brain model. A model name is not a secret.
JARVIS_BRAIN_MODEL=deepseek-v4.1-flash

# ── Local gateway (optional: OmniRoute is a user-installed add-on) ───────────
# Asha does NOT bundle OmniRoute. The two names below select the gateway
# transport and tell Asha where a locally running OmniRoute listens, so a user
# who installs and runs OmniRoute themselves can point Asha at it without any
# code change. These exact names are what the app reads: with
# JARVIS_BRAIN_TRANSPORT=omniroute, the endpoint is OMNIROUTE_BASE_URL
# (default http://127.0.0.1:20128/v1). Neither is a secret.
#
# If you do not run OmniRoute, either point these at the gateway URL you use,
# or switch JARVIS_BRAIN_TRANSPORT to `deepseek` (key: DEEPSEEK_API_KEY) or
# `opencode` (key: SUPERVISOR_API_KEY / OPENCODE_API_KEY) and supply your own
# key. Setting the transport explicitly also stops a non-packaged start (e.g.
# JARVIS_DATA_DIR unset) from falling back to a personal OpenCode endpoint.
JARVIS_BRAIN_TRANSPORT=omniroute
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# ── Asha proxy (managed plans) ───────────────────────────────────────────────
# The Asha proxy on Cloudflare is where the managed provider keys live. Point
# the app (and any gateway you run) at it with these two names. Neither is
# bundled with a value:
#   JARVIS_GATEWAY_URL=https://<your-asha-proxy-host>
#   JARVIS_TOKEN=<issued to the user at sign-in; never shipped>
#
# Build-time shortcut: export JARVIS_PROXY_URL before running a build script
# and it appends JARVIS_GATEWAY_URL automatically. JARVIS_TOKEN is always added
# at runtime by sign-in, never by a build.
